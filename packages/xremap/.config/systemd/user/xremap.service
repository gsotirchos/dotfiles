[Unit]
Description=xremap — macOS-style app-aware Super shortcuts (reads keyd virtual keyboard)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# --device pins xremap to keyd's output so it sees the post-Alt/Meta-swap
# stream and does not fight keyd over the physical keyboard grab.
# --watch=config,device reloads on config edits and re-grabs the device if
# keyd restarts.
ExecStart=/usr/local/bin/xremap \
    --device "keyd virtual keyboard" \
    --watch=config,device \
    %h/.config/xremap/config.yml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
