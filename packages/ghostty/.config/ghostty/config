font-synthetic-style = false
#adjust-cell-width = -5%
adjust-cell-height = 30%

window-padding-x = 11
window-padding-y = 0
#window-step-resize = true
window-width = 80
window-height = 24
window-vsync = true

quit-after-last-window-closed = true
shell-integration-features = ssh-env
bell-features = system
mouse-hide-while-typing = true
cursor-opacity = 1.0

theme = light:custom-modus-operandi, dark:custom-modus-vivendi

keybind = shift+escape=text:~
keybind = alt+delete=esc:d
keybind = super+delete=text:\x15
keybind = super+shift+up=jump_to_prompt:-1
keybind = super+shift+down=jump_to_prompt:+1
keybind = super+enter=unbind
keybind = super+ctrl+up=unbind
keybind = super+ctrl+down=unbind
keybind = super+ctrl+right=unbind
keybind = super+ctrl+left=unbind
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind

# OS-specific overrides. Placed last so per-OS values override anything above.
config-file = ?os.conf
