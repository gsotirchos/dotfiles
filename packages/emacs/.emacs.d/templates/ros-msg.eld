my-ros-msg-mode

(header "std_msgs/Header header" q)
(constant (p "int32" type) " " (p "CONSTANT_NAME") "=" (p "0") q)
(field_array (p "float64" type) "[] " (p "values") q)
(field_fixed_array (p "float64" type) "[" (p "3") "] " (p "values") q)
(field_bounded_array (p "float64" type) "[<=" (p "10") "] " (p "values") q)
(field_string_default "string " (p "name") " \"" (p "default") "\"" q)
(field_default (p "float64" type) " " (p "value") " " (p "0.0") q)
(service_split "---" q)
(action_split "---" n "---" q)
(pose "geometry_msgs/Pose " (p "pose") q)
(pose_stamped "geometry_msgs/PoseStamped " (p "pose") q)
(twist "geometry_msgs/Twist " (p "twist") q)
(transform "geometry_msgs/TransformStamped " (p "transform") q)
(point "geometry_msgs/Point " (p "position") q)
(quaternion "geometry_msgs/Quaternion " (p "orientation") q)
(duration "builtin_interfaces/Duration " (p "duration") q)
(time "builtin_interfaces/Time " (p "stamp") q)
