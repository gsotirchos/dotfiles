[credential]
    helper = store
[user]
    name = George Sotirchos
    #email = gsotirch@gmail.com
    email = G.Sotirchos@tudelft.nl
[init]
    defaultBranch = main
[pull]
    rebase = true
[rebase]
    updateRefs = true
[status]
    submodulesummary = 1
[push]
    recurseSubmodules = check
[submodule]
    recurse = true
[diff]
    tool = vimdiff
    submodule = log
[core]
    excludesFile = ~/.dotfiles/.gitignore
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[pager]
    log = "sed \
        -e 's/\\x1b\\[1;31m\\([^\\x1b]*\\/HEAD\\x1b\\)/\\x1b[1;36m\\1/g' \
        -e 's/\\x1b\\[1;31m\\(upstream\\/\\)/\\x1b[1;35m\\1/g' \
        | less"
[url "git@github.com:"]
    insteadOf = https://github.com/
[url "git@gitlab.tudelft.nl:"]
    insteadOf = https://gitlab.tudelft.nl/
