[credential]
    helper = store
[user]
    name = George Sotirchos
    email = gsotirch@gmail.com
[includeIf "hasconfig:remote.*.url:git@gitlab.tudelft.nl:*/**"]
    path = ~/.gitconfig-tud
[includeIf "hasconfig:remote.*.url:git@gitlab.tudelft.nl:*"]
    path = ~/.gitconfig-tud
[includeIf "hasconfig:remote.*.url:https://gitlab.tudelft.nl/**"]
    path = ~/.gitconfig-tud
[includeIf "hasconfig:remote.*.url:git@github.com:sam-xl/**"]
    path = ~/.gitconfig-tud
[includeIf "hasconfig:remote.*.url:https://github.com/sam-xl/**"]
    path = ~/.gitconfig-tud
[init]
    defaultBranch = main
[pull]
    rebase = true
[rebase]
    updateRefs = true
[status]
    submodulesummary = 1
[push]
    recurseSubmodules = check
[alias]
    spull = submodule update --init --recursive
    drop-filter-backups = "!git for-each-ref --format='delete %(refname)' 'refs/original*/**' | tee /dev/stderr | git update-ref --stdin"
[log]
        initialDecorationSet = all
[diff]
    tool = vimdiff
    submodule = log
[core]
    excludesFile = ~/.dotfiles/.gitignore
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[pager]
    log = "sed \
        -e 's/\\x1b\\[1;31m\\([^\\x1b]*\\/HEAD\\x1b\\)/\\x1b[1;36m\\1/g' \
        -e 's/\\x1b\\[1;31m\\(upstream\\/\\)/\\x1b[1;34m\\1/g' \
        | less"
[url "git@github.com:"]
    insteadOf = https://github.com/
[url "git@gitlab.tudelft.nl:"]
    insteadOf = https://gitlab.tudelft.nl/
