[credential]
    helper = store
[user]
    name = George Sotirchos
    #email = gsotirch@gmail.com
    email = G.Sotirchos@tudelft.nl
[init]
    defaultBranch = main
[pull]
    rebase = true
[rebase]
    updateRefs = true
[status]
    submodulesummary = 1
[push]
    recurseSubmodules = check
[submodule]
    recurse = true
[diff]
    tool = vimdiff
    submodule = log
[core]
    excludesFile = ~/.dotfiles/.gitignore
[alias]
    slog = log --graph --decorate --all --stat
    olog = log --graph --decorate --all --oneline
    sync = !git stash && git pull --recurse-submodules=off && git stash apply && git add . && git commit -m \"${1-\"Update locally\"}\" && git push && git stash clear && :
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[url "git@github.com:"]
    insetadOf = https://github.com/
[url "git@gitlab.tudelft.nl:"]
    insetadOf = https://gitlab.tudelft.nl/
