{
  "respectGitignore": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(emacs-query:*)",
      "Bash(glab api:*)",
      "Bash(glab repo:*)"
    ]
  },
  "model": "opus",
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "emacs-query@gsotirchos-emacs-query": true
  },
  "extraKnownMarketplaces": {
    "gsotirchos-emacs-query": {
      "source": {
        "source": "directory",
        "path": "~/Projects/emacs-query"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "promptSuggestionEnabled": false,
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "ghostty",
  "wheelScrollAccelerationEnabled": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // empty\"); [[ \"$f\" =~ \\.(c|cc|cpp|cxx|h|hh|hpp|hxx)$ ]] || exit 0; clang-format -i --style=file --fallback-style=none \"$f\" >&2 || exit 2",
            "statusMessage": "Formatting C/C++ with clang-format"
          },
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // empty\"); [[ \"$f\" == *.py ]] || exit 0; ruff-fix \"$f\" >&2 || exit 2",
            "statusMessage": "Fixing Python with ruff"
          }
        ]
      }
    ]
  }
}
