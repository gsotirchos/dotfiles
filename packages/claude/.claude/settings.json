{
  "respectGitignore": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(emacs-query:*)",
      "Bash(glab api:*)",
      "Bash(glab repo:*)"
    ]
  },
  "model": "opus",
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "emacs-query@gsotirchos": true
  },
  "extraKnownMarketplaces": {
    "gsotirchos": {
      "source": {
        "source": "settings",
        "name": "gsotirchos",
        "owner": {
          "name": "George Sotirchos"
        },
        "plugins": [
          {
            "name": "emacs-query",
            "source": {
              "source": "github",
              "repo": "gsotirchos/emacs-query"
            }
          }
        ]
      },
      "autoUpdate": true
    }
  },
  "spinnerTipsEnabled": false,
  "promptSuggestionEnabled": false,
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "ghostty",
  "wheelScrollAccelerationEnabled": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // empty\"); case \"$f\" in *.c|*.cc|*.cpp|*.cxx|*.h|*.hh|*.hpp|*.hxx) ;; *) exit 0 ;; esac; clang-format -i --style=file --fallback-style=none \"$f\" >&2 || exit 2",
            "statusMessage": "Formatting C/C++ with clang-format"
          },
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_input.file_path // empty\"); case \"$f\" in *.py) ;; *) exit 0 ;; esac; cd \"$(dirname \"$f\")\" || exit 2; ruff check --fix --quiet \"$f\" >&2; unfixed=$?; ruff format --silent \"$f\" >&2 || exit 2; [ \"$unfixed\" -eq 0 ] || exit 2",
            "statusMessage": "Fixing Python with ruff"
          }
        ]
      }
    ]
  }
}
