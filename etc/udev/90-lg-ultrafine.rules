# LG UltraFine Display Controls (043e:9a63) — grant the active-seat user
# access to the hidraw node so brightness can be set without sudo.
# `uaccess` adds an ACL for the logged-in user; GROUP=plugdev is a fallback.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="043e", ATTRS{idProduct}=="9a63", TAG+="uaccess", MODE="0660", GROUP="plugdev"
