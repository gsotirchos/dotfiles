#!/usr/bin/env python3
"""A very barebones CMake formatter.

It re-indents CMake code and breaks command arguments onto their own lines,
matching the hand-written style of this project's CMakeLists.txt.

Usage:
    cmake_format CMakeLists.txt      # print formatted to stdout
    cmake_format                     # read stdin, write stdout

Formatting knobs can be overridden per run, e.g.
    cmake_format --indent-width 4 --no-always-wrap-groups CMakeLists.txt
"""

import argparse
import re
import sys


class CMakeFormatter:
    """An opinionated CMake formatter.

    It does NOT try to be a full parser; it assumes a few conventions:

      * commands / statements are lowercase:   add_library(...)
      * keyword arguments are UPPERCASE:        DESTINATION, PUBLIC, SHARED
      * the arguments before the first keyword argument group stay on the opening
        line (a target/variable), while pure keyword-led or list commands put
        every argument on its own indented line.

    The formatting knobs (indent width, line width, whether to always wrap
    groups/subgroups) are set per instance.
    """

    BLOCK_OPEN = ("if", "foreach", "while", "function", "macro", "block")
    BLOCK_MID = ("else", "elseif")
    BLOCK_CLOSE = ("endif", "endforeach", "endwhile", "endfunction", "endmacro", "endblock")

    KWARG_RE = re.compile(r"^[A-Z][A-Z0-9_]*$")

    NAME_FIRST_RE = re.compile(r"^(add_(executable|library|test))$")

    def __init__(
        self,
        indent_width=2,
        line_width=100,
        always_wrap_groups=True,
        always_wrap_subgroups=False,
    ):
        self.indent_width = indent_width
        self.line_width = line_width
        self.always_wrap_groups = always_wrap_groups
        self.always_wrap_subgroups = always_wrap_subgroups

    def _pad(self, indent):
        """Indent string for a given nesting level."""
        return " " * (self.indent_width * indent)

    @classmethod
    def is_kwarg(cls, arg):
        """True for a bare UPPERCASE token like DESTINATION or PUBLIC."""
        return bool(cls.KWARG_RE.match(arg))

    @staticmethod
    def tokenize(src):
        """Turn source text into a flat list of ('kind', value?) tokens."""
        toks = []
        i, n = 0, len(src)
        while i < n:
            c = src[i]
            if c == "\n":
                toks.append(("nl",))
                i += 1
            elif c in " \t\r":
                i += 1
            elif c == "#":
                j = i
                while j < n and src[j] != "\n":
                    j += 1
                toks.append(("comment", src[i:j].rstrip()))
                i = j
            elif c == "(":
                toks.append(("lp",))
                i += 1
            elif c == ")":
                toks.append(("rp",))
                i += 1
            elif c == '"':
                j = i + 1
                while j < n and src[j] != '"':
                    j += 2 if src[j] == "\\" else 1
                j = min(j + 1, n)
                toks.append(("word", src[i:j]))
                i = j
            else:
                j = i
                while j < n and src[j] not in ' \t\r\n()#"':
                    j += 1
                toks.append(("word", src[i:j]))
                i = j
        return toks

    @staticmethod
    def parse(toks):
        """Group tokens into top-level elements (command, comment, blank, raw).

        Runs of two or more newlines collapse to a single "blank" so the output
        preserves paragraph breaks but not arbitrary vertical whitespace.
        """
        elements = []
        i, blanks = 0, 0
        while i < len(toks):
            t = toks[i]
            if t[0] == "nl":
                blanks += 1
                i += 1
                continue
            if blanks >= 2 and elements and elements[-1][0] != "blank":
                elements.append(("blank",))
            blanks = 0

            if t[0] == "comment":
                elements.append(("comment", t[1]))
                i += 1
            elif t[0] == "word" and i + 1 < len(toks) and toks[i + 1][0] == "lp":
                name = t[1]
                args, depth, j = [], 1, i + 2
                while j < len(toks) and depth > 0:
                    tj = toks[j]
                    if tj[0] == "lp":
                        depth += 1
                    elif tj[0] == "rp":
                        depth -= 1
                    elif tj[0] == "word":
                        args.append(tj[1])
                    j += 1
                elements.append(("command", name, args))
                i = j
            else:
                elements.append(("raw", t[1] if len(t) > 1 else ""))
                i += 1
        return elements

    def opening_count(self, name, args):
        """How many leading args stay on the command's opening line."""
        if not args:
            return 0
        if self.NAME_FIRST_RE.match(name):
            return 1  # name-first command: its single name/target anchors the line
        if self.is_kwarg(args[0]):
            return 0 if any(self.is_kwarg(a) for a in args[1:]) else 1
        if any(self.is_kwarg(a) for a in args[1:]):
            # name-led command with keyword groups: keep the leading names (up to
            # the first keyword that introduces a value) on the opening line
            for i in range(1, len(args) - 1):
                if self.is_kwarg(args[i]) and not self.is_kwarg(args[i + 1]):
                    return i
            return 1
        return 0  # a flat value list has no distinguished name; put every arg below

    def _split(self, name, args):
        """Split args into (head, groups): the leading args that stay on the
        opening line, and the KEYWORD-led / standalone-value groups to break out."""
        oc = self.opening_count(name, args)
        return args[:oc], self.group_args(args[oc:])

    def group_args(self, args):
        """Split trailing args into lines: `KEYWORD value...` groups and lone
        values each on their own line. A library-type keyword (SHARED, STATIC,
        ...) is just an UPPERCASE keyword, so its source attaches:
        `SHARED foo.cpp`."""
        groups, cur, last = [], [], None  # last: 'kw' | 'val' | None
        for a in args:
            if self.is_kwarg(a):
                if last == "kw":
                    cur.append(a)  # consecutive keywords share a line
                else:
                    if cur:
                        groups.append(cur)
                    cur = [a]
                last = "kw"
            else:  # value
                if cur and last in ("kw", "val"):
                    cur.append(a)  # attaches to its keyword's line
                    last = "val"
                else:
                    if cur:
                        groups.append(cur)
                        cur = []
                    groups.append([a])  # standalone value on its own line
                    last = "val"
        if cur:
            groups.append(cur)
        return groups

    def wrap(self, pad, tokens):
        """Render one keyword group, keeping it on a single `pad`-indented line
        and exploding it to one token per line only when that line would
        overflow (or always_wrap_subgroups forces it)."""
        line = f"{pad}{' '.join(tokens)}"
        if len(tokens) == 1:
            return [line]
        if self.always_wrap_subgroups or len(line) > self.line_width:
            return [f"{pad}{tok}" for tok in tokens]
        return [line]

    def wants_block(self, name, args, head, single):
        """Should this command spread its arguments over multiple lines?

        Anything wider than line_width always wraps. Control-flow commands
        (if/foreach/...) are otherwise immune and stay on one line. Beyond that a
        command stays on one line unless always_wrap_groups breaks it up, which
        happens when it has structure to spread out:
          * an empty head — nothing stays on the opening line — so every argument
            goes below: keyword-led commands like install(DIRECTORY ...
            DESTINATION ...) and flat value lists like add_compile_options(-Wall
            -Wextra);
          * a leading name followed by values or keyword groups that break onto
            their own lines below it, e.g. add_executable(app src...) or
            target_include_directories(t PUBLIC inc SYSTEM other) — the name is
            kept on the opening line by opening_count.
        Commands whose only tail is the keyword itself stay on one line:
        set(MY_VAR foo), find_package(pkg REQUIRED), add_library(mylib INTERFACE)."""
        if len(args) <= 1:
            return False
        if len(single) > self.line_width:
            return True
        if name in self.BLOCK_OPEN or name in self.BLOCK_MID or name in self.BLOCK_CLOSE:
            return False
        if not self.always_wrap_groups:
            return False
        if not head:
            return True
        return not self.is_kwarg(head[0]) and any(not self.is_kwarg(a) for a in args[1:])

    def render_command(self, name, args, indent):
        """Format a single command, either on one line or spread across an
        indented block (closing paren on its own line) when wants_block says so.

        The opening-line args fall back to the block form if keeping them up top
        would already overflow line_width.
        """
        pad = self._pad(indent)
        head, groups = self._split(name, args)
        single = f"{pad}{name}({' '.join(args)})"
        if not self.wants_block(name, args, head, single):
            return single

        head_line = f"{pad}{name}({' '.join(head)}"
        if head and len(head_line) > self.line_width:
            head, groups = [], self.group_args(args)
            head_line = f"{pad}{name}("
        lines = [head_line]
        sub = self._pad(indent + 1)
        for g in groups:
            lines += self.wrap(sub, g)
        lines.append(f"{pad})")
        return "\n".join(lines)

    def format(self, src):
        """Format a whole CMake source string.

        Block commands (if/foreach/function/...) drive the running indent level;
        leading and trailing blank lines are stripped so output ends in one
        newline.
        """
        elements = self.parse(self.tokenize(src))
        out, indent = [], 0
        for el in elements:
            kind = el[0]
            if kind == "blank":
                out.append("")
            elif kind == "comment":
                out.append(f"{self._pad(indent)}{el[1]}")
            elif kind == "raw":
                if el[1]:
                    out.append(f"{self._pad(indent)}{el[1]}")
            elif kind == "command":
                name = el[1]
                if name in self.BLOCK_CLOSE or name in self.BLOCK_MID:
                    indent = max(0, indent - 1)
                out.append(self.render_command(name, el[2], indent))
                if name in self.BLOCK_OPEN or name in self.BLOCK_MID:
                    indent += 1
        while out and out[0] == "":
            out.pop(0)
        while out and out[-1] == "":
            out.pop()
        return "\n".join(out) + "\n"


def main():
    parser = argparse.ArgumentParser(description="A very barebones CMake formatter.")
    parser.add_argument("file", nargs="?", help="CMake file to format; reads stdin if omitted")
    parser.add_argument("--indent-width", type=int, default=2, help="spaces per indent level")
    parser.add_argument("--line-width", type=int, default=100, help="column to wrap at")
    parser.add_argument(
        "--always-wrap-groups",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="wrap keyword groups",
    )
    parser.add_argument(
        "--always-wrap-subgroups",
        action=argparse.BooleanOptionalAction,
        default=False,
        help="wrap each token within a group",
    )
    args = parser.parse_args()

    formatter = CMakeFormatter(
        indent_width=args.indent_width,
        line_width=args.line_width,
        always_wrap_groups=args.always_wrap_groups,
        always_wrap_subgroups=args.always_wrap_subgroups,
    )

    if args.file:
        with open(args.file, encoding="utf-8") as f:
            src = f.read()
    else:
        src = sys.stdin.read()
    sys.stdout.write(formatter.format(src))


if __name__ == "__main__":
    main()
