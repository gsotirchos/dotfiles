#!/usr/bin/env python3
"""A very barebones CMake formatter.

It re-indents CMake code and breaks command arguments onto their own lines,
matching the hand-written style of this project's CMakeLists.txt. It does NOT
try to be a full parser; it assumes the conventions the user described:

  * commands / statements are lowercase:   add_library(...)
  * keyword arguments are UPPERCASE:        DESTINATION, PUBLIC, SHARED
  * the first non-keyword argument is the "name" that stays on the opening
    line (a target/variable), while pure keyword-led or list commands put
    every argument on its own indented line.

Usage:
    python3 cmake_format.py CMakeLists.txt      # print formatted to stdout
    python3 cmake_format.py                     # read stdin, write stdout
"""

import re
import sys

INDENT = "  "
LINE_WIDTH = 100
ALWAYS_WRAP_GROUPS = True
ALWAYS_WRAP_SUBGROUPS = False

OWN_LINE_KEYWORDS = {}

BLOCK_OPEN = {"if", "foreach", "while", "function", "macro", "block"}
BLOCK_MID = {"else", "elseif"}
BLOCK_CLOSE = {
    "endif",
    "endforeach",
    "endwhile",
    "endfunction",
    "endmacro",
    "endblock",
}

NAME_FIRST_RE = re.compile(r"(ament_)?target_|(set_|get_)\w*(properties|property)$")

_KWARG_RE = re.compile(r"^[A-Z][A-Z0-9_]*$")


def is_kwarg(arg):
    """True for a bare UPPERCASE token like DESTINATION or PUBLIC."""
    return bool(_KWARG_RE.match(arg))


def tokenize(src):
    """Turn source text into a flat list of ('kind', value?) tokens."""
    toks = []
    i, n = 0, len(src)
    while i < n:
        c = src[i]
        if c == "\n":
            toks.append(("nl",))
            i += 1
        elif c in " \t\r":
            i += 1
        elif c == "#":
            j = i
            while j < n and src[j] != "\n":
                j += 1
            toks.append(("comment", src[i:j].rstrip()))
            i = j
        elif c == "(":
            toks.append(("lp",))
            i += 1
        elif c == ")":
            toks.append(("rp",))
            i += 1
        elif c == '"':
            j = i + 1
            while j < n and src[j] != '"':
                j += 2 if src[j] == "\\" else 1
            j = min(j + 1, n)
            toks.append(("word", src[i:j]))
            i = j
        else:
            j = i
            while j < n and src[j] not in ' \t\r\n()#"':
                j += 1
            toks.append(("word", src[i:j]))
            i = j
    return toks


def parse(toks):
    """Build a list of elements: command / comment / blank."""
    elements = []
    i, blanks = 0, 0
    while i < len(toks):
        t = toks[i]
        if t[0] == "nl":
            blanks += 1
            i += 1
            continue
        if blanks >= 2 and elements and elements[-1][0] != "blank":
            elements.append(("blank",))
        blanks = 0

        if t[0] == "comment":
            elements.append(("comment", t[1]))
            i += 1
        elif t[0] == "word" and i + 1 < len(toks) and toks[i + 1][0] == "lp":
            name = t[1]
            args, depth, j = [], 1, i + 2
            while j < len(toks) and depth > 0:
                tj = toks[j]
                if tj[0] == "lp":
                    depth += 1
                elif tj[0] == "rp":
                    depth -= 1
                elif tj[0] == "word":
                    args.append(tj[1])
                j += 1
            elements.append(("command", name, args))
            i = j
        else:
            elements.append(("raw", t[1] if len(t) > 1 else ""))
            i += 1
    return elements


def opening_count(name, args):
    """How many leading args stay on the command's opening line."""
    if not args:
        return 0
    first = args[0]
    if is_kwarg(first):
        return 0 if any(is_kwarg(a) for a in args[1:]) else 1
    if any(is_kwarg(a) for a in args[1:]) or NAME_FIRST_RE.match(name):
        for i in range(1, len(args) - 1):
            if is_kwarg(args[i]) and not is_kwarg(args[i + 1]):
                return i
        return 1
    return 1  # a plain non-keyword first arg is the target name; keep it up top


def group_args(args):
    """Split trailing args into lines: `KEYWORD value...` groups and lone
    values each on their own line. A library-type keyword (SHARED, STATIC, ...)
    is just an UPPERCASE keyword, so its source attaches: `SHARED foo.cpp`."""
    groups, cur, last = [], [], None  # last: 'kw' | 'val' | None
    for a in args:
        if a in OWN_LINE_KEYWORDS:
            if cur:
                groups.append(cur)
            groups.append([a])
            cur, last = [], None
            continue
        if is_kwarg(a):
            if last == "kw":
                cur.append(a)  # consecutive keywords share a line
            else:
                if cur:
                    groups.append(cur)
                cur = [a]
            last = "kw"
        else:  # value
            if cur and last in ("kw", "val"):
                cur.append(a)  # attaches to its keyword's line
                last = "val"
            else:
                if cur:
                    groups.append(cur)
                    cur = []
                groups.append([a])  # standalone value on its own line
                last = "val"
    if cur:
        groups.append(cur)
    return groups


def wrap(pad, tokens):
    """`tokens` as one `pad`-indented line, or—when that would exceed LINE_WIDTH
    (or ALWAYS_WRAP_SUBGROUPS is on) and there's more than one token—each token
    on its own `pad`-indented line."""
    line = f"{pad}{' '.join(tokens)}"
    if len(tokens) == 1:
        return [line]
    if ALWAYS_WRAP_SUBGROUPS or len(line) > LINE_WIDTH:
        return [f"{pad}{tok}" for tok in tokens]
    return [line]


def wants_block(name, args, oc, single):
    """Should this command spread its arguments over multiple lines?

    A command that fits under LINE_WIDTH stays on one line — unless
    ALWAYS_WRAP_GROUPS asks it to be broken up regardless. Those are:
      * keyword-led commands, where nothing stays on the opening line, e.g.
        install(DIRECTORY ... DESTINATION ...);
      * name-led commands, where a target name is followed by a list of values
        to break out, e.g. add_executable(name src...) or
        ament_target_dependencies(name deps...);
      * the target_*/set_*_properties family matched by NAME_FIRST_RE.
    Commands with no value list beyond the name — set(MY_VAR foo),
    find_package(pkg REQUIRED) — stay on one line."""
    if len(args) <= 1:
        return False
    if len(single) > LINE_WIDTH:
        return True
    if not ALWAYS_WRAP_GROUPS:
        return False
    if oc == 0 and any(is_kwarg(a) for a in args):
        return True
    if not is_kwarg(args[0]) and any(not is_kwarg(a) for a in args[1:]):
        return True
    return bool(NAME_FIRST_RE.match(name))


def render_command(name, args, indent):
    pad = INDENT * indent
    oc = opening_count(name, args)
    single = f"{pad}{name}({' '.join(args)})"
    if not wants_block(name, args, oc, single):
        return single

    if oc and len(f"{pad}{name}({' '.join(args[:oc])}") > LINE_WIDTH:
        oc = 0
    head, rest = args[:oc], args[oc:]
    lines = [f"{pad}{name}({' '.join(head)}"]
    for g in group_args(rest):
        lines += wrap(f"{pad}{INDENT}", g)
    lines.append(f"{pad})")
    return "\n".join(lines)


def format_cmake(src):
    elements = parse(tokenize(src))
    out, indent = [], 0
    for el in elements:
        kind = el[0]
        if kind == "blank":
            out.append("")
        elif kind == "comment":
            out.append(f"{INDENT * indent}{el[1]}")
        elif kind == "raw":
            if el[1]:
                out.append(f"{INDENT * indent}{el[1]}")
        elif kind == "command":
            name = el[1]
            if name in BLOCK_CLOSE or name in BLOCK_MID:
                indent = max(0, indent - 1)
            out.append(render_command(name, el[2], indent))
            if name in BLOCK_OPEN or name in BLOCK_MID:
                indent += 1
    while out and out[0] == "":
        out.pop(0)
    while out and out[-1] == "":
        out.pop()
    return "\n".join(out) + "\n"


def main():
    if len(sys.argv) > 1:
        with open(sys.argv[1], encoding="utf-8") as f:
            src = f.read()
    else:
        src = sys.stdin.read()
    sys.stdout.write(format_cmake(src))


if __name__ == "__main__":
    main()
