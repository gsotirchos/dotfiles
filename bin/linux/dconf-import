#!/usr/bin/env bash
set -euo pipefail

main() {
    local dotfiles
    dotfiles="$(builtin cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../.." >/dev/null && pwd)"
    local infile="${dotfiles}/config/dconf/user.conf"

    if [[ ! -f "${infile}" ]]; then
        echo "Error: ${infile} not found." >&2
        exit 1
    fi

    dconf load / < "${infile}"
    echo "Imported config/dconf/user.conf → dconf"
}

main "$@"
