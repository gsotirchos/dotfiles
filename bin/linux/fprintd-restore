#!/usr/bin/env python3
"""Recover a wedged fprintd by resetting the fingerprint sensor's USB device
and restarting the daemon. Usage: sudo fprintd-restore"""

import fcntl
import os
import subprocess
import sys
from pathlib import Path

SENSOR_VID = "06cb"
SENSOR_PID = "0106"
# https://github.com/torvalds/linux/blob/master/include/uapi/linux/usbdevice_fs.h
USBDEVFS_RESET = (ord("U") << 8) | 20


def find_sensor_devnode() -> Path | None:
    for sysfs_dev in Path("/sys/bus/usb/devices").iterdir():
        try:
            vid = (sysfs_dev / "idVendor").read_text().strip()
            pid = (sysfs_dev / "idProduct").read_text().strip()
            if (vid, pid) != (SENSOR_VID, SENSOR_PID):
                continue
            bus = int((sysfs_dev / "busnum").read_text())
            dev = int((sysfs_dev / "devnum").read_text())
        except OSError:
            continue
        return Path(f"/dev/bus/usb/{bus:03d}/{dev:03d}")
    return None


def usb_reset(devnode: Path) -> None:
    fd = os.open(devnode, os.O_WRONLY)
    try:
        fcntl.ioctl(fd, USBDEVFS_RESET, 0)
    finally:
        os.close(fd)


def main() -> None:
    if os.geteuid() != 0:
        sys.exit(f"Run with sudo: sudo {sys.argv[0]}")

    devnode = find_sensor_devnode()
    if devnode is None:
        print(
            f"Sensor {SENSOR_VID}:{SENSOR_PID} not found; skipping USB reset.",
            file=sys.stderr,
        )
    else:
        usb_reset(devnode)
        print(f"USB reset sent to {devnode}.")

    subprocess.run(["systemctl", "restart", "fprintd"], check=True)
    print("fprintd restarted.")


if __name__ == "__main__":
    main()
